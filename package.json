{
  "name": "ancestor-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/check-data-fresh.ts && tsx scripts/validate-data.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate-data": "tsx scripts/validate-data.ts",
    "data:fetch": "tsx scripts/fetch/cliopatria.ts && tsx scripts/fetch/wikidata.ts",
    "data:fetch:wikipedia": "tsx scripts/fetch/wikipedia.ts",
    "data:fetch:pbdb": "tsx scripts/fetch/pbdb.ts",
    "data:fetch:paleo": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/fetch/paleo.ts",
    "data:paleo": "tsx scripts/paleo.ts",
    "data:climate": "tsx scripts/climate.ts",
    "data:ingest:road": "tsx scripts/ingest/road.ts",
    "data:build": "tsx scripts/build-data.ts && tsx scripts/validate-data.ts && tsx scripts/report-data.ts",
    "data:report": "tsx scripts/report-data.ts",
    "sites:candidates": "tsx scripts/fetch/site-candidates.ts",
    "sites:sync": "tsx scripts/sync-site-coords.ts",
    "data:check": "tsx scripts/check-data-fresh.ts",
    "data:describe": "tsx scripts/describe.ts",
    "audio:narrate": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/audio/narrate.ts",
    "audio:music": "tsx scripts/audio/music.ts",
    "audio:upload": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/audio/upload.ts"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rapideditor/country-coder": "^5.6.1",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "csv-parse": "^7.0.3",
    "d3-contour": "^4.0.2",
    "h5wasm": "^0.10.3",
    "mapshaper": "^0.7.78",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
